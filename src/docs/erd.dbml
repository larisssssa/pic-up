Table Users {
  id int [pk]
  name varchar
  email varchar
  isAdmin boolean
}

Table Projects {
  id int [pk]
  name varchar
  sessionDate datetime
  userId int [ref: > Users.id]
  statusId varchar [ref: > Status.id]
}

Table Photos {
  id int [pk]
  projectId int [ref: > Projects.id]
}

Table Status {
  id int [pk]
  status varchar
}

Table ProjectPhoto {
  id int [pk]
  projectId int [ref: > Projects.id]
  photoId int [ref: > Photos.id]
}